# --- Game Window & Timing ---
APP_TITLE=My Configured Space Game
GAME_WIDTH=900
GAME_HEIGHT=700
GAME_TICK_MS=16
BOTTOM_UI_BUFFER=40

# --- Database ---
# Use forward slashes even on Windows for JDBC paths
DATABASE_URL=jdbc:sqlite:terrible_game_data.db
JDBC_DRIVER=org.sqlite.JDBC
HIGH_SCORE_LIMIT=15

# --- Player ---
PLAYER_WIDTH=40
PLAYER_HEIGHT=20
PLAYER_SPEED=6
PLAYER_COLOR=#00FFFF # Cyan hex
INITIAL_LIVES=3

# --- Bullet ---
BULLET_WIDTH=6
BULLET_HEIGHT=12
BULLET_SPEED=10
BULLET_COLOR=#FFFF00 # Yellow hex

# --- Enemy ---
MAX_ENEMIES=20
ENEMY_SPAWN_CHANCE=0.06
ENEMY_BASE_SPEED=3
ENEMY_SPEED_VARIATION=4
ENEMY_BASE_SIZE=25
ENEMY_SIZE_VARIATION=35
ENEMY_SCORE_VALUE=15
ENEMY_COLOR=#FF0000 # Red hex

# --- PowerUp ---
MAX_POWERUPS=7
POWERUP_SPAWN_CHANCE=0.025
POWERUP_WIDTH=18
POWERUP_HEIGHT=18
POWERUP_BASE_SPEED=4
POWERUP_SPEED_VARIATION=2
POWERUP_SCORE_VALUE=75
POWERUP_COLOR=#00FF00 # Green hex

# --- UI Elements (Login Screen) ---
LOGIN_BACKGROUND_COLOR=#222222 # Dark Gray
LOGIN_LABEL_COLOR=#FFFFFF # White
LOGIN_STATUS_ERROR_COLOR=#FF4444 # Lighter Red
LOGIN_STATUS_SUCCESS_COLOR=#44FF44 # Lighter Green
LOGIN_HIGHSCORE_FG_COLOR=#00FFFF # Cyan
LOGIN_HIGHSCORE_BG_COLOR=#000000 # Black
LOGIN_HIGHSCORE_FONT_NAME=Courier New
LOGIN_HIGHSCORE_FONT_STYLE=PLAIN
LOGIN_HIGHSCORE_FONT_SIZE=13

# --- UI Elements (Game Panel) ---
GAME_BACKGROUND_COLOR=#101010 # Very Dark Gray
GAME_UI_TEXT_COLOR=#DDDDDD # Light Gray
GAME_UI_FONT_NAME=Verdana
GAME_UI_FONT_STYLE=BOLD
GAME_UI_FONT_SIZE=18

GAME_OVER_TEXT_COLOR=#FFA500 # Orange
GAME_OVER_FONT_NAME=Impact
GAME_OVER_LARGE_FONT_STYLE=BOLD
GAME_OVER_LARGE_FONT_SIZE=52
GAME_OVER_MEDIUM_FONT_STYLE=BOLD
GAME_OVER_MEDIUM_FONT_SIZE=28
GAME_OVER_SMALL_FONT_STYLE=PLAIN
GAME_OVER_SMALL_FONT_SIZE=18

PAUSE_OVERLAY_COLOR=#AA000000 # Transparent Black (AA alpha)
PAUSE_TEXT_COLOR=#FFFFFF # White
PAUSE_FONT_NAME=Arial
PAUSE_LARGE_FONT_STYLE=BOLD
PAUSE_LARGE_FONT_SIZE=50
PAUSE_SMALL_FONT_STYLE=ITALIC
PAUSE_SMALL_FONT_SIZE=16

# --- Card Layout IDs (Less common to change) ---
# LOGIN_PANEL_ID=LoginScreen
# GAME_PANEL_ID=GameScreen